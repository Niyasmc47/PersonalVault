# PersonalVault Environment Configuration Example

# Database Configuration
DB_USERNAME=personalvault_user
DB_PASSWORD=your_secure_password

# JWT Secret
JWT_SECRET=YourSuperSecretJwtKeyChangeThisInProduction

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Drive Integration
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/api/integrations/google-drive/callback

# Secure Vault Configuration
VAULT_ENCRYPTION_KEY=personalvault-secure-vault-encryption-secret-key-2026
VAULT_SESSION_EXPIRATION_MINUTES=15

# SmartDrop AI Classification Provider (optional: local or openai)
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
